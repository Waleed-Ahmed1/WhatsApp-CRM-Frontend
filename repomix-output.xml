    display: flex;
    align-items: center;
    justify-content: space-between;
}


/* ================================
   SELECTED USER — avatar colors unchanged
================================ */

.selected-user {
    display: flex;
    align-items: center;
    flex-direction: row;
    gap: 15px;
}

.selected-avatar {
    width: 44px;
    height: 44px;

    margin: 0;

    position: relative;

    border-radius: 50%;

    background: #37393a;

    color: #ffffff;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 17px;
    font-weight: 500;

    flex-shrink: 0;
}

.selected-user-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.selected-user-info h3 {
    margin: 0;

    color: #fff;

    font-size: 18px;
    font-weight: 520;
}

.selected-user-info span {
    color: #25d366;
    font-size: 12px;
}


/* ================================
   HEADER ACTIONS — matched to app theme
================================ */

.chat-actions {
    display: flex;
    align-items: center;

    gap: 5px;
}

.chat-actions button {
    width: 40px;
    height: 40px;

    border: none;
    border-radius: 50%;

    background: transparent;

    color: #9aa0ac;

    cursor: pointer;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 15px;
}

.chat-actions button:hover {
    background: #232838;
}


/* ================================
   MESSAGES AREA — unchanged (original)
================================ */

.messages-area {
    flex: 1;

    padding: 25px 5%;

    overflow-y: auto;

    display: flex;
    flex-direction: column;

    gap: 7px;

    background-color: #0b141a;

    background-image:
        radial-gradient(
            rgba(255, 255, 255, 0.025) 1px,
            transparent 1px
        );

    background-size: 18px 18px;
}


/* ================================
   DATE — unchanged (original)
================================ */

.chat-date {
    display: flex;
    justify-content: center;

    margin: 5px 0 15px;
}

.chat-date span {
    padding: 6px 12px;

    border-radius: 7px;

    background: #202c33;

    color: #8696a0;

    font-size: 11px;
}


/* ================================
   MESSAGE ROW — unchanged (original)
================================ */

.message-row {
    width: 100%;

    display: flex;
}

.message-row.received {
    justify-content: flex-start;
}

.message-row.sent {
    justify-content: flex-end;
}



/* ================================
   MESSAGE BUBBLE — unchanged (original)
================================ */

.message-bubble {
    max-width: 65%;

    padding: 8px 10px 6px;

    border-radius: 8px;

    position: relative;

    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.2);
}


.received .message-bubble {
    background: #202c33;
    border-top-left-radius: 2px;
}



.sent .message-bubble {
    background: #005c4b;   /* WhatsApp's real dark-mode outgoing green */
    border-top-right-radius: 2px;
}


.message-bubble p {
    margin: 0;

    padding-right: 45px;

    color: #e9edef;

    font-size: 14px;

    line-height: 1.4;
}

.message-time {
    display: block;

    margin-top: 4px;

    text-align: right;

    color: #8696a0;

    font-size: 10px;
}

.sent .message-time {
    color: #8ca8a1;
}



.received .message-bubble {
    background: #202c33;
    border-top-left-radius: 2px;
}



/* ================================
   MESSAGE INPUT — unchanged (original)
================================ */

.message-input-area {
    min-height: 56px;

    padding: 8px 12px;

    display: flex;
    align-items: center;

    gap: 4px;

    background: #202c33;   /* outer bar background — matches header/sidebar tone */

    border-top: none;
}


/* ================================
   INPUT — unchanged (original)
================================ */

.message-input-area input {
    flex: 1;

    height: 42px;

    padding: 0 12px;

    border: none;
    outline: none;

    border-radius: 21px;

    background: #2a3942;   /* the pill itself — the dark rounded capsule from your screenshot */

    color: #e9edef;

    font-size: 15px;

    margin: 0 4px;
}

.message-input-area input::placeholder {
    color: #8696a0;
}


/* ================================
   INPUT ICON BUTTONS — unchanged (original)
================================ */

.message-icon-btn {
    width: 40px;
    height: 40px;

    flex-shrink: 0;

    border: none;

    border-radius: 50%;

    background: transparent;

    color: #aebac1;

    cursor: pointer;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 17px;
}

.message-icon-btn:hover {
    background: #2a3942;
}

.send-message-btn {
    width: 42px;
    height: 42px;

    flex-shrink: 0;

    border: none;

    border-radius: 50%;

    background: #00a884;

    color: #000000;

    cursor: pointer;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 17px;

    box-shadow: 0 2px 6px rgba(0, 168, 132, 0.4);
}

.send-message-btn:hover {
    background: #06cf9c;
}


/* ================================
   RESPONSIVE
================================ */

@media (max-width: 900px) {

    .chat-list {
        width: 300px;
        min-width: 300px;
    }

    .messages-area {
        padding: 20px 4%;
    }

    .message-bubble {
        max-width: 75%;
    }
}


@media (max-width: 700px) {

    .chat-list {
        width: 100%;
        min-width: 100%;
        display: flex;
    }

    .chat-window {
        display: none;
        width: 100%;

        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 10;
    }

    /* When a contact is selected on mobile: hide list, show full-screen chat */
    .livechat-page.mobile-chat-open .chat-list {
        display: none;
    }

    .livechat-page.mobile-chat-open .chat-window {
        display: flex;
    }
}

/* Back button — hidden on desktop, shown only on mobile */
.chat-back-btn {
    display: none;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: #e9edef;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
}

.chat-back-btn:hover {
    background: #232838;
}

@media (max-width: 700px) {
    .chat-back-btn {
        display: flex;
    }
}

/* ================================
   MESSAGE TICKS (sent / delivered / read)
================================ */

.tick-icon {
    font-size: 12px;
    margin-left: 4px;
    vertical-align: middle;
}

/* single grey tick — sent, not yet delivered */
.tick-sent {
    color: #8696a0;
}

/* double grey tick — delivered, not yet read */
.tick-delivered {
    color: #8696a0;
}

/* double blue tick — read */
.tick-read {
    color: #53bdeb;
}

/* ================================
   EMPTY CHAT WINDOW STATE
================================ */

.chat-window-empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    color: #8696a0;
    text-align: center;
    padding: 40px;
}

.chat-window-empty h2 {
    color: #e9edef;
    font-weight: 300;
    font-size: 26px;
    margin: 0;
}

.chat-window-empty p {
    font-size: 13px;
    margin: 0;
    max-width: 320px;
}

.no-messages-text {
    text-align: center;
    color: #8696a0;
    font-size: 13px;
    margin-top: 40px;
}

/* ================================
   EMPTY CHAT LIST STATE
================================ */

.chat-list-empty {
    flex: 1;
    height: 100%;          /* ← add this */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 40px 24px;
    color: #6b7280;
    text-align: center;
}
.chat-list-empty svg {
    color: #232838;
}

.chat-list-empty p {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    max-width: 220px;
}

.selected-user-info span {
    color: #8696a0;
    font-size: 12px;
}


.message-media-image,
.message-media-video {
    max-width: 260px;
    max-height: 260px;
    border-radius: 6px;
    display: block;
    margin-bottom: 6px;
}

.message-media-audio {
    max-width: 240px;
    margin-bottom: 6px;
}

.message-media-doc {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #53bdeb;
    text-decoration: none;
    font-size: 13px;
    margin-bottom: 6px;
}

.message-media-doc:hover {
    text-decoration: underline;
}

.message-input-area-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
}

.selected-file-pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin: 0 12px 6px;
    padding: 6px 12px;
    background: #2a3942;
    border-radius: 8px;
    color: #e9edef;
    font-size: 12px;
}

.selected-file-pill button {
    background: transparent;
    border: none;
    color: #f87171;
    cursor: pointer;
    font-size: 13px;
}

.emoji-picker {
    position: absolute;
    bottom: 60px;
    left: 12px;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 6px;
    background: #202c33;
    border: 1px solid #232838;
    border-radius: 10px;
    padding: 10px;
    z-index: 20;
}

.emoji-picker button {
    background: transparent;
    border: none;
    font-size: 20px;
    cursor: pointer;
    padding: 4px;
    border-radius: 6px;
}

.emoji-picker button:hover {
    background: #2a3942;
}
