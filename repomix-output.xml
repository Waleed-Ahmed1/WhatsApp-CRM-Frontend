<file path="src/css/sidebar.css">
* {
  font-family: Arial, Helvetica, sans-serif;
}

/* ===== Base sidebar (desktop default) ===== */
.sidebar {
  width: 216px;
  background: #141824;
  border-right: 1px solid #232838;
  display: flex;
  flex-direction: column;
  height: 100vh;
  flex-shrink: 0;
}

.sidebar-header {
  padding: 22px 18px 18px;
  border-bottom: 1px solid #232838;
}

.sidebar-logo-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.sidebar-logo {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: #25d366;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 18px rgba(37, 211, 102, 0.28);
  flex-shrink: 0;
}

.sidebar-title {
  color: #fff;
  font-weight: 700;
  font-size: 15px;
}

.sidebar-live {
  color: #25d366;
  font-size: 10px;
  font-family: monospace;
}

.sidebar-nav {
  flex: 1;
  padding: 10px 8px;
  overflow-y: auto;
}

.sidebar-link {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 9px 12px;
  border-radius: 9px;
  margin-bottom: 2px;
  text-decoration: none;
  background: transparent;
  color: #9aa0ac;
  font-size: 14px;
  font-weight: 400;
  transition: all 0.15s;
}

.sidebar-link.active {
  background: rgba(37, 211, 102, 0.12);
  color: #25d366;
  font-weight: 600;
}

.sidebar-icon {
  font-size: 15px;
  flex-shrink: 0;
