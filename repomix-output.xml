                                    <option key={cat} value={cat}>
                                        {cat}
                                    </option>
                                ))}
                            </select>
                        </div>

                        <div className="dialog-actions">
                            <button className="dialog-cancel-btn" onClick={() => setShowAddDialog(false)}>Cancel</button>
