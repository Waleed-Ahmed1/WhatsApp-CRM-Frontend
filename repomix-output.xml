<file path="src/css/contacts.css">
.contacts-page {
  background: #0b0d12;
  min-height: 100vh;
  padding: 24px;
  font-family: sans-serif;
}

.contacts-top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.contacts-title {
  color: #fff;
  font-size: 20px;
  margin: 0;
  font-family: monospace;
}

.contacts-subtitle {
  color: #6b7280;
  font-size: 13px;
  margin: 4px 0 0;
}

/* ===== Search ===== */

.contacts-search-wrap {
  position: relative;
  margin-bottom: 18px;
  max-width: 340px;
}

.contacts-search {
  width: 100%;
  background: #141824;
  border: 1px solid #232838;
  border-radius: 8px;
  color: #fff;
  padding: 10px 34px 10px 12px;
  font-size: 13px;
  box-sizing: border-box;
}

.contacts-search:focus {
  outline: none;
  border-color: #25d366;
}

.contacts-search-icon {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: #6b7280;
  font-size: 15px;
}

/* ===== Card / table ===== */

.contacts-card {
  background: #141824;
  border: 1px solid #232838;
  border-radius: 12px;
  overflow: hidden;
}

.contacts-empty {
  padding: 40px;
  text-align: center;
  color: #6b7280;
  font-size: 13px;
}

.contacts-table {
  width: 100%;
  border-collapse: collapse;
  color: #fff;
}

.contacts-table thead tr {
  border-bottom: 1px solid #232838;
  text-align: left;
}

.contacts-table th {
  padding: 14px 16px;
  color: #9aa0ac;
  font-size: 11.5px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}

/* Message column header + cell both centered so the icon lines up under the label */
.contacts-table th:nth-child(5) {
  text-align: center;
}

.contacts-actions-head {
  width: 48px;
}

.contact-row {
  border-bottom: 1px solid #1c2130;
  cursor: pointer;
  transition: background 0.12s ease;
}

.contact-row:last-child {
  border-bottom: none;
}

.contact-row:hover {
  background: #1a1f2c;
}

.contacts-table td {
  padding: 12px 16px;
  font-size: 13.5px;
  vertical-align: middle;
}

.contact-number {
  color: #5a6274;
  font-size: 12px;
  width: 36px;
}

/* ===== Avatar + name ===== */

.contact-name-cell {
  display: flex;
  align-items: center;
  gap: 12px;
}

.contact-avatar {
  width: 38px;
  height: 38px;
  min-width: 38px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #06210f;
  font-size: 15px;
  font-weight: 700;
  box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.04);
}

.contact-name-info {
  min-width: 0;
}

.contact-name {
  color: #e6e8ec;
  font-size: 14px;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 220px;
}

.contact-phone {
  color: #9aa0ac;
  font-family: monospace;
  font-size: 12.5px;
}

/* ===== Group ===== */

.contact-group-badge {
  background: rgba(37, 211, 102, 0.12);
  color: #25d366;
  font-size: 11.5px;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 20px;
  white-space: nowrap;
}

.contact-group-empty {
  color: #5a6274;
  font-size: 12px;
}

/* ===== Message column: chat icon button ===== */

.contact-message-cell {
  text-align: center;
}

.contact-chat-icon-btn {
  background: rgba(37, 211, 102, 0.1);
  border: 1px solid rgba(37, 211, 102, 0.25);
  color: #25d366;
  border-radius: 8px;
  width: 34px;
  height: 34px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 15px;
  transition: background 0.15s, transform 0.15s;
}

.contact-chat-icon-btn:hover {
  background: rgba(37, 211, 102, 0.2);
  transform: scale(1.05);
}

/* ===== Actions ===== */

.contact-actions-cell {
  position: relative;
  text-align: right;
  width: 48px;
}

.contact-more-btn {
  background: transparent;
  border: none;
  color: #6b7280;
  cursor: pointer;
  padding: 6px 8px;
  border-radius: 6px;
  font-size: 13px;
}

.contact-more-btn:hover {
  background: #232838;
  color: #fff;
}

.contact-actions-menu {
  position: absolute;
  right: 8px;
  top: 38px;
  background: #1a1f2c;
  border: 1px solid #232838;
  border-radius: 8px;
  min-width: 150px;
  z-index: 20;
  overflow: hidden;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
}

.contact-actions-menu button {
  width: 100%;
  text-align: left;
  background: transparent;
  border: none;
  color: #e6e8ec;
  padding: 10px 14px;
  font-size: 13px;
  cursor: pointer;
}

.contact-actions-menu button:hover {
  background: #232838;
}

/* ===== Loading ===== */

.su-loading {
  padding: 60px 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.spinner {
  width: 28px;
  height: 28px;
  border: 3px solid #232838;
  border-top-color: #25d366;
  border-radius: 50%;
  animation: contacts-spin 0.7s linear infinite;
}

@keyframes contacts-spin {
  to { transform: rotate(360deg); }
}

/* =========================================================
   RESPONSIVE
   All columns stay visible at every screen size — everything
   just shrinks progressively. If content still doesn't fit,
   the table scrolls horizontally instead of clipping.
   ========================================================= */

@media (max-width: 900px) {
  .contacts-page {
    padding: 18px;
  }

  .contacts-table th,
  .contacts-table td {
    padding: 11px 12px;
    font-size: 13px;
  }

  .contact-name {
    max-width: 160px;
  }
}

@media (max-width: 640px) {
  .contacts-card {
    overflow-x: auto;
  }

  .contacts-table {
    min-width: 620px; /* forces horizontal scroll instead of squashing columns unreadably */
  }

  .contacts-page {
    padding: 12px;
  }

  .contacts-title {
    font-size: 16px;
  }

  .contacts-subtitle {
    font-size: 11.5px;
  }

  .contact-name {
    max-width: 130px;
    font-size: 13px;
  }

  .contacts-table th,
  .contacts-table td {
    padding: 9px 10px;
    font-size: 12.5px;
  }

  .contacts-table th {
    font-size: 10.5px;
  }

  .contact-avatar {
    width: 32px;
    height: 32px;
    min-width: 32px;
    font-size: 12.5px;
  }

  .contact-chat-icon-btn {
    width: 28px;
    height: 28px;
    font-size: 12px;
  }

  .contact-more-btn {
    padding: 4px 6px;
    font-size: 12px;
  }

  .contact-group-badge {
    font-size: 10.5px;
    padding: 3px 9px;
  }

  .contact-phone {
    font-size: 11.5px;
  }
}

@media (max-width: 380px) {
  .contacts-page {
    padding: 8px;
  }

  .contacts-title {
    font-size: 14.5px;
  }

  .contacts-subtitle {
    font-size: 10.5px;
  }

  .contacts-search {
    padding: 8px 30px 8px 10px;
    font-size: 12px;
  }

  .contacts-table {
    min-width: 560px;
  }

  .contacts-table th,
  .contacts-table td {
    padding: 7px 6px;
    font-size: 11.5px;
  }

  .contacts-table th {
    font-size: 9.5px;
  }

  .contact-name {
    max-width: 90px;
    font-size: 12px;
  }

  .contact-number {
    width: 20px;
    font-size: 10.5px;
  }

  .contact-avatar {
    width: 28px;
    height: 28px;
    min-width: 28px;
    font-size: 11px;
  }

  .contact-chat-icon-btn {
    width: 25px;
    height: 25px;
    font-size: 11px;
  }
}

.contact-actions-menu.open-up {
    top: auto;
    bottom: 38px;
}
