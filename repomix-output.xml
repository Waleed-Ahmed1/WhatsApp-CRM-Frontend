<file path="src/css/setting.css">
.settings-page {
    background: #0b0d12;
    min-height: 100vh;
    padding: 24px;
    font-family: sans-serif;
    box-sizing: border-box;
}


.settings-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
}

.settings-title {
    color: #fff;
    font-size: 20px;
    margin: 0;
    font-family: monospace;
}

.settings-subtitle {
    color: #6b7280;
    font-size: 13px;
    margin: 4px 0 0;
}


.settings-sections {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    width: 100%;
    max-width: 1100px;
    align-items: start;
}

/* =========================
   SETTINGS CARD
========================= */

.settings-card {
    background: #141824;
    border: 1px solid #232838;
    border-radius: 12px;
    padding: 24px;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
}

.settings-card-title {
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 6px;
}

.settings-hint {
    color: #6b7280;
    font-size: 12px;
    line-height: 1.4;
    margin: 0 0 16px;
}


.settings-system-card {
    grid-column: 1 / -1;
}

.settings-textarea {
    min-height: 280px;
    resize: vertical;
    line-height: 1.5;
}


.settings-input {
    width: 100%;
    height: 42px;
    background: #0b0d12;
    border: 1px solid #232838;
    border-radius: 8px;
    padding: 10px 12px;
    color: #fff;
    font-family: monospace;
    font-size: 13px;
    box-sizing: border-box;
    margin-bottom: 16px;
}

.settings-input:focus {
    outline: none;
    border-color: #25d366;
}

.settings-input::placeholder {
    color: #5b6472;
}

.settings-input:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

/* =========================
   SLIDER
========================= */

.slider-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
}

.settings-slider {
    flex: 1;
    min-width: 0;
    -webkit-appearance: none;
    appearance: none;
    height: 4px;
    border-radius: 4px;
    background: #232838;
    outline: none;
}

.settings-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #25d366;
    cursor: pointer;
    box-shadow: 0 0 8px rgba(37, 211, 102, 0.5);
}

.settings-slider::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: none;
    border-radius: 50%;
    background: #25d366;
    cursor: pointer;
    box-shadow: 0 0 8px rgba(37, 211, 102, 0.5);
}

.slider-value {
    min-width: 52px;
    text-align: center;
    background: rgba(37, 211, 102, 0.12);
    color: #25d366;
    font-family: monospace;
    font-size: 13px;
    padding: 4px 8px;
    border-radius: 20px;
    flex-shrink: 0;
}

/* =========================
   SAVE BUTTON
========================= */

.settings-save-btn {
    background: rgba(37, 211, 102, 0.15);
    color: #25d366;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease;
}

.settings-save-btn:hover {
    background: rgba(37, 211, 102, 0.22);
}

.settings-save-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

/* =========================
   AI TOGGLE
========================= */

.ai-toggle-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #141824;
    border: 1px solid #232838;
    border-radius: 30px;
    padding: 8px 16px 8px 8px;
    cursor: pointer;
    transition: border-color 0.15s ease;
}

.ai-toggle-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.ai-toggle-btn.on {
    border-color: rgba(37, 211, 102, 0.35);
}

.ai-toggle-track {
    width: 38px;
    height: 20px;
    border-radius: 20px;
    background: #232838;
    position: relative;
    transition: background 0.2s ease;
    flex-shrink: 0;
}

.ai-toggle-btn.on .ai-toggle-track {
    background: #25d366;
}

.ai-toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #fff;
    transition: transform 0.2s ease;
}

.ai-toggle-btn.on .ai-toggle-thumb {
    transform: translateX(18px);
}

.ai-toggle-label {
    font-family: monospace;
    font-size: 12px;
    font-weight: 600;
    color: #9aa0ac;
    white-space: nowrap;
}

.ai-toggle-btn.on .ai-toggle-label {
    color: #25d366;
}

/* =========================
   TABLET
========================= */

@media (max-width: 900px) {
    .settings-page {
        padding: 20px 16px;
    }

    .settings-sections {
        gap: 14px;
    }

    .settings-card {
        padding: 18px;
    }

    .settings-textarea {
        min-height: 240px;
    }
}

/* =========================
   PHONE
   TWO CARDS PER ROW
========================= */

@media (max-width: 600px) {
    .settings-page {
        padding: 14px 10px;
    }

    .settings-header {
        gap: 14px;
        margin-bottom: 18px;
    }

    .settings-title {
        font-size: 17px;
    }

    .settings-subtitle {
        font-size: 11px;
    }

    .settings-sections {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        width: 100%;
    }

    .settings-card {
        padding: 12px 10px;
        border-radius: 9px;
    }

    .settings-card-title {
        font-size: 12px;
        margin-bottom: 5px;
    }

    .settings-hint {
        font-size: 9px;
        line-height: 1.3;
        margin-bottom: 10px;
    }

    .settings-input {
        height: 34px;
        padding: 7px 8px;
        font-size: 9px;
        border-radius: 6px;
        margin-bottom: 9px;
    }

    .settings-save-btn {
        width: 100%;
        padding: 7px 4px;
        font-size: 9px;
        border-radius: 6px;
    }

    /* System prompt stays full width */
    .settings-system-card {
        grid-column: 1 / -1;
    }

    .settings-textarea {
        min-height: 200px;
        font-size: 10px;
    }

    /* AI toggle */
    .ai-toggle-btn {
        width: 30%;
        justify-content: center;
        padding: 7px 12px 7px 7px;
    }

    .ai-toggle-track {
        width: 30px;
        height: 16px;
    }

    .ai-toggle-thumb {
        width: 13px;
        height: 13px;
        top: 2px;
        left: 2px;
    }

    .ai-toggle-btn.on .ai-toggle-thumb {
        transform: translateX(16px);
    }

    .ai-toggle-label {
        font-size: 10px;
    }

    /* Slider */
    .slider-row {
        gap: 7px;
        margin-bottom: 12px;
    }

    .settings-slider {
        height: 3px;
    }

    .settings-slider::-webkit-slider-thumb {
        width: 13px;
        height: 13px;
    }

    .settings-slider::-moz-range-thumb {
        width: 13px;
        height: 13px;
    }

    .slider-value {
        min-width: 38px;
        font-size: 9px;
        padding: 3px 5px;
    }
}

/* =========================
   SMALL PHONE
========================= */

@media (max-width: 400px) {
    .settings-page {
        padding: 10px 7px;
    }

    .settings-header {
        margin-bottom: 14px;
    }

    .settings-title {
        font-size: 16px;
    }

    .settings-subtitle {
        font-size: 10px;
    }

    .settings-sections {
        gap: 6px;
    }

    .settings-card {
        padding: 10px 8px;
        border-radius: 8px;
    }

    .settings-card-title {
        font-size: 10px;
    }

    .settings-hint {
        font-size: 8px;
        margin-bottom: 8px;
    }

    .settings-input {
        height: 31px;
        padding: 6px 7px;
        font-size: 8px;
        margin-bottom: 8px;
    }

    .settings-save-btn {
        padding: 6px 3px;
        font-size: 8px;
    }

    .settings-textarea {
        min-height: 180px;
        font-size: 9px;
    }

    .slider-row {
        gap: 5px;
    }

    .slider-value {
        min-width: 34px;
        font-size: 8px;
    }
}
