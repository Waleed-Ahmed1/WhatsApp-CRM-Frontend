:root {
    --bg: #0b0d12;
    --card-bg: #141824;
    --primary: #25d366;
    --text: #ffffff;
    --muted: #9aa0ac;
    --dimmer: #6b7280;
    --border: #232838;
}

.login-page {
    min-height: 100vh;
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: sans-serif;
}

.login-wrapper {
    width: 380px;
}

.login-header {
    text-align: center;
    margin-bottom: 40px;
}

.login-logo {
    width: 58px;
    height: 58px;
    border-radius: 18px;
    background: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 14px;
    box-shadow: 0 0 36px rgba(37, 211, 102, 0.3);
}

.login-title {
    color: var(--text);
    font-size: 24px;
    font-weight: 700;
    margin: 0;
}

.login-subtitle {
    color: var(--muted);
    font-size: 14px;
    margin-top: 6px;
}

.login-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 32px;
}

.field {
    margin-bottom: 16px;
}

.field:nth-of-type(2) {
    margin-bottom: 24px;
}

.label {
    display: block;
    color: var(--muted);
    font-size: 13px;
    margin-bottom: 6px;
}

.input {
    width: 100%;
    padding: 10px 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-size: 14px;
    outline: none;
    box-sizing: border-box;
}

.input:focus {
    border-color: var(--primary);
}

.error-text {
    color: #f87171;
    font-size: 13px;
    margin-bottom: 16px;
    text-align: center;
}

.submit-btn {
    width: 100%;
    padding: 12px;
    background: var(--primary);
    border: none;
    border-radius: 10px;
    color: #0b0d12;
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
}

.submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.login-footer {
    color: var(--dimmer);
    text-align: center;
    margin-top: 18px;
    font-size: 13px;
    font-family: monospace;
}

.footer-link {
    color: #25d366;
    text-decoration: none;
    font-weight: 600;
}

.footer-link:hover {
    text-decoration: underline;
}
